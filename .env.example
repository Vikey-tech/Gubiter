# Local configuration reference. Go reads process environment, not .env files.
HTTP_ADDR=127.0.0.1:8080
# Reference only: browser Auth reads web/static/js/supabase-config.js instead.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Keep any secret/service-role key server-side and out of version control.
